# ais-its-emission-service — every variable the service reads (docs/PLATFORM_SPEC.md §4, §13.5).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=emission
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3006
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000
# Proxies whose X-Forwarded-For is trusted (IPs, CIDRs, loopback/linklocal/uniquelocal).
# Production: the gateway's address or CIDR ONLY (spec §4); the default trusts every private
# network, so any host inside it could choose its client IP (audit records), and the service
# logs a warning at boot while it is in effect.
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- PostgreSQL (TimescaleDB + PostGIS), schema "emission" ---------------------
DATABASE_URL=postgres://emission_svc:emission_svc@localhost:5432/aisits
DATABASE_SCHEMA=emission
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed.
# The server's max_payload should be at least 4 MB (compose and infra/nats/nats.conf set it);
# the service logs a warning at boot when it is lower.
NATS_URL=nats://localhost:4222
# Prefix of every durable consumer name (only for test suites sharing one server).
# NATS_DURABLE_PREFIX=

# --- Valkey: weather cache (0.25° cell × UTC hour) ----------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (not used by this service's routes, read by the kit).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
# Browser origins allowed by CORS. Exposed response headers: X-Request-Id, Retry-After,
# WWW-Authenticate, ETag, Location (kit) and Content-Disposition, X-Truncated (CSV exports).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Tracing (OTLP/HTTP traces only; disabled when unset) ---------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# --- Segments and CII (spec §13.5) --------------------------------------------------
# Longest time between two fixes that still forms a counted segment, minutes (longer = flag "gap").
SEGMENT_MAX_GAP_MIN=360
# Telemetry is active for a segment with a reading overlapping it or within this many minutes of its end.
TELEMETRY_ACTIVE_WINDOW_MIN=10
# Longest measured period (time - periodStart) of a fuel reading, hours (1-744); must be at least the
# telemetry service's TELEMETRY_MAX_PERIOD_H (same name and default) or long readings are not fully attributed.
TELEMETRY_MAX_PERIOD_H=24
# Minimum interval between two emission.cii.updated.v1 of one vessel, seconds.
CII_PUBLISH_INTERVAL_S=60
# How often vessels with unpublished CII changes are checked, milliseconds.
CII_PUBLISH_POLL_MS=5000
# Longest delay before late segment changes (days before today) reach cii_daily / cii_annual, milliseconds.
CII_AGGREGATE_REFRESH_MS=30000
# Longest range of POST /cii/vessels/:mmsi/recompute, days (AIS_POSITION keeps 7 days).
RECOMPUTE_MAX_DAYS=7

# --- Weather for the Holtrop path (Open-Meteo, CC BY 4.0) ---------------------------
# Base URL of the forecast API (requests go to {WEATHER_API_URL}/v1/forecast).
WEATHER_API_URL=https://api.open-meteo.com
# false = calm weather for every Holtrop segment (flag weather_unavailable), no requests.
WEATHER_ENABLED=true
WEATHER_TIMEOUT_MS=3000
# Lifetime of a cached cell-hour in Valkey, seconds (7 days).
WEATHER_CACHE_TTL_S=604800
# Consecutive failures that open the circuit breaker, and how long it stays open (ms).
WEATHER_BREAKER_THRESHOLD=5
WEATHER_BREAKER_COOLDOWN_MS=60000
